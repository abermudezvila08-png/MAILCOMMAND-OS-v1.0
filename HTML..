<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MailCommand OS AI</title>

<style>
:root{
  --bg:#070707;
  --panel:#111;
  --accent:#ff7a00;
  --gold:#d4af37;
  --text:#f5f5f5;
  --muted:#999;
}

body{
  margin:0;
  font-family:Arial;
  background:var(--bg);
  color:var(--text);
}

/* LAYOUT */
.container{
  display:grid;
  grid-template-columns:1fr 1fr;
  height:100vh;
}

/* DASHBOARD */
.dashboard{
  padding:15px;
  overflow:auto;
  border-right:1px solid #222;
}

.card{
  background:var(--panel);
  padding:12px;
  margin-bottom:10px;
  border-radius:10px;
}

h2{
  color:var(--gold);
}

/* CHAT */
.chat{
  display:flex;
  flex-direction:column;
  height:100vh;
}

.messages{
  flex:1;
  padding:15px;
  overflow:auto;
}

.msg{
  margin-bottom:10px;
  padding:10px;
  border-radius:10px;
}

.user{
  background:#222;
}

.ai{
  background:#111;
  border-left:3px solid var(--accent);
}

.inputBox{
  display:flex;
  padding:10px;
  border-top:1px solid #222;
}

input{
  flex:1;
  padding:10px;
  border:none;
  border-radius:6px;
  outline:none;
}

button{
  margin-left:10px;
  background:var(--accent);
  border:none;
  padding:10px;
  border-radius:6px;
  font-weight:bold;
}
</style>
</head>

<body>

<div class="container">

<!-- DASHBOARD -->
<div class="dashboard">
  <h2>📊 Executive Dashboard</h2>

  <div class="card">📧 Correos: <b>3,421</b></div>
  <div class="card">📋 Tareas: <b>18</b></div>
  <div class="card">💰 Facturas: <b>9</b></div>
  <div class="card">🚨 Riesgos: <b>1</b></div>
  <div class="card">🗑 Suscripciones: <b>47</b></div>

  <div class="card">
    🧠 Estado IA: <b style="color:#ff7a00">ACTIVA</b><br>
    Motor: ChatGPT Embedded
  </div>
</div>

<!-- CHAT IA -->
<div class="chat">

  <div class="messages" id="messages">
    <div class="msg ai">
      👋 Soy tu asistente ejecutivo. ¿Qué deseas analizar hoy?
    </div>
  </div>

  <div class="inputBox">
    <input id="input" placeholder="Escribe aquí..." />
    <button onclick="send()">Enviar</button>
  </div>

</div>

</div>

<script>
async function send(){
  let input = document.getElementById("input");
  let text = input.value;
  if(!text) return;

  addMsg(text,"user");
  input.value="";

  let response = await fakeAI(text);

  addMsg(response,"ai");
}

function addMsg(text,type){
  let div = document.createElement("div");
  div.className="msg "+type;
  div.innerText=text;
  document.getElementById("messages").appendChild(div);
}

async function fakeAI(prompt){

  // 🔥 SIMULACIÓN INTELIGENTE (REEMPLAZABLE POR OPENAI API)

  if(prompt.toLowerCase().includes("correo")){
    return "He detectado 12 correos urgentes y 3 facturas pendientes.";
  }

  if(prompt.toLowerCase().includes("factura")){
    return "Hay 2 facturas próximas a vencer en 48 horas.";
  }

  if(prompt.toLowerCase().includes("riesgo")){
    return "Se detectó 1 posible intento de phishing en tu bandeja Gmail.";
  }

  if(prompt.toLowerCase().includes("resumen")){
    return "Resumen: actividad alta en correos, 18 tareas abiertas, 47 suscripciones activas.";
  }

  return "Procesando análisis… (IA lista para integración real con OpenAI API)";
}
</script>

</body>
</html>